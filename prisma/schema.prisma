generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  notes     Note[]
  createdAt DateTime @default(now())
}
model Note {
  id           String   @id @default(cuid())
  userId       String
  title        String
  rawText      String
  summary      Json?
  summaryHash  String?
  ttsKey       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  User         User     @relation(fields: [userId], references: [id])
  @@index([userId])
}
